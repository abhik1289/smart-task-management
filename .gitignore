# =============================================================
# Smart Task Management - Root .gitignore
# Covers: Client (React/Vite/TS) + Taskmanagement (Spring Boot)
# =============================================================

# ---------------------------------------------------------
# Environment & Secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt
secrets/
config/local.*

# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
spring.log

# ---------------------------------------------------------
# OS Files
# ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------
# IDE / Editor - Root level (allow specific team-shared files)
# ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# ---------------------------------------------------------
# Client (React + Vite + TypeScript)
# ---------------------------------------------------------
client/node_modules/
client/dist/
client/dist-ssr/
client/build/
client/coverage/
client/*.local
client/.env
client/.env.*
!.client/.env.example
client/.vite/
client/.cache/
client/.next/
client/.nuxt/
client/.parcel-cache/
client/.eslintcache
client/.stylelintcache

# ---------------------------------------------------------
# Taskmanagement (Spring Boot / Maven)
# ---------------------------------------------------------
taskmanagement/target/
taskmanagement/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
taskmanagement/build/
taskmanagement/.gradle/
taskmanagement/out/

# IDE specific to Java
taskmanagement/.apt_generated
taskmanagement/.classpath
taskmanagement/.factorypath
taskmanagement/.project
taskmanagement/.settings
taskmanagement/.springBeans
taskmanagement/.sts4-cache
taskmanagement/nbproject/
taskmanagement/nbbuild/
taskmanagement/nbdist/
taskmanagement/.nb-gradle/

# ---------------------------------------------------------
# Database / Persistence
# ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.mdb
data/
postgres-data/
pgdata/

# ---------------------------------------------------------
# Docker / Container Volumes
# ---------------------------------------------------------
docker-compose.override.yml
.docker/

# ---------------------------------------------------------
# Backups & Temp files
# ---------------------------------------------------------
*.bak
*.tmp
*.temp
*.swp
*.orig
*.rej
*.zip
*.tar.gz
backup/

# ---------------------------------------------------------
# Testing & Coverage
# ---------------------------------------------------------
coverage/
.nyc_output/
junit.xml
test-results/
*.lcov

# ---------------------------------------------------------
# Misc
# ---------------------------------------------------------
.history/
.tmp/
.temp/
.cache/
.parcel-cache/